{
  "name": "aei-relay",
  "version": "4.6.1",
  "private": true,
  "description": "Æ TWA fused relay — stateless Cloudflare Worker with two routes: ?url= for crawler fetch (title + SHA-256 text hash + links, SSRF-blocked), ?symbol= for market data (Kraken→Stooq→Binance→CoinGecko→Yahoo). Consumed end-to-end by the fused app.py (CrawlerWorker + MarketTickWorker). Version: Final, First edition.",
  "author": "Natalia Tanyatia",
  "license": "UNLICENSED",
  "main": "worker.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "secret:put": "wrangler secret put RELAY_KEY",
    "secret:list": "wrangler secret list",
    "whoami": "wrangler whoami",
    "login": "wrangler login",
    "logout": "wrangler logout",
    "typecheck": "wrangler deploy --dry-run --outdir=dist"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "cloudflare": {
    "name": "aei-relay",
    "main": "worker.js",
    "compatibility_date": "2024-11-01"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "crawler",
    "crawler-relay",
    "fetch-proxy",
    "stateless",
    "sha256",
    "content-hash",
    "link-extraction",
    "title-extraction",
    "kraken",
    "stooq",
    "binance",
    "coingecko",
    "yahoo-finance",
    "market-data",
    "ae",
    "ae-twa",
    "fusion",
    "gaia",
    "aetheric-intelligence",
    "final-edition"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/aei-relay"
  },
  "bugs": {
    "url": "https://github.com/yourusername/aei-relay/issues"
  },
  "homepage": "https://github.com/yourusername/aei-relay#readme"
}
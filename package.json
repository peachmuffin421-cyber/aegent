{
  "name": "aei-relay",
  "version": "1.0-final-first",
  "private": true,
  "description": "AE TWA relay — stateless Cloudflare Worker. Proxies /miniapp-state, /cs-state, /cs-feedback, /step, /handshake, /teach, /say, /encode-syllable, /crawler-enqueue, /reset, /order, /order/close, /notify-aea, /fvg, /log, DELETE /orders, DELETE /fvg/<id> to the backend. Backend authoritative. No synthetic bars. Final, First edition.",
  "author": "Natalia Tanyatia",
  "license": "UNLICENSED",
  "main": "worker.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "secret:put": "wrangler secret put RELAY_KEY",
    "secret:list": "wrangler secret list",
    "whoami": "wrangler whoami",
    "login": "wrangler login",
    "logout": "wrangler logout",
    "typecheck": "wrangler deploy --dry-run --outdir=dist"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "cloudflare": {
    "name": "ae-relay",
    "main": "worker.js",
    "compatibility_date": "2024-01-01"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "proxy",
    "stateless",
    "backend-authoritative",
    "ae",
    "ae-twa",
    "fusion",
    "gaia",
    "aetheric-intelligence",
    "final-first"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/<OWNER>/<RELAY-REPO>"
  },
  "bugs": {
